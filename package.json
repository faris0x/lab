{
  "name": "lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local maths tools for lab.faris0x.dev",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run wasm && astro dev",
    "build": "npm run wasm && astro build",
    "preview": "astro preview",
    "wasm": "bash scripts/build-wasm.sh",
    "wasm:install": "cargo install wasm-bindgen-cli --version 0.2.130 --locked",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml --workspace",
    "size": "bash scripts/check-wasm-size.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "9.1.2",
    "@fontsource-variable/hubot-sans": "^5.3.0",
    "astro": "^7.4.9",
    "d3-scale": "^4.0.3",
    "katex": "^0.19.1",
    "mathlive": "^0.111.4",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.19.2",
    "svelte-check": "^4.7.8",
    "vitest": "^5.1.0"
  }
}
